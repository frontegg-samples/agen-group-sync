# agen-group-sync configuration.
# Copy to .env, fill in, and keep it out of version control.
# Full explanation of every value: docs/OPERATIONS.md §4.

# ── Google Workspace ─────────────────────────────────────────────────────────
# A service account with DOMAIN-WIDE DELEGATION, impersonating a super-admin.
# Only two read-only scopes are needed; see docs/OPERATIONS.md §3.1.
GOOGLE_CLIENT_EMAIL=agen-group-sync@your-project.iam.gserviceaccount.com
GOOGLE_IMPERSONATE_SUBJECT=admin@yourdomain.com
GOOGLE_CUSTOMER_ID=my_customer

# Prefer the _FILE form with a mounted secret. The inline form warns on every run.
GOOGLE_PRIVATE_KEY_FILE=/run/secrets/google-private-key.pem
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Frontegg ──────────────────────────────────────────────────────────
FRONTEGG_BASE_URL=https://api.frontegg.com
FRONTEGG_TENANT_ID=
# Required by POST /users/v2 — it is NOT taken from the token. See docs/OPERATIONS.md §4.1.
FRONTEGG_APPLICATION_ID=

FRONTEGG_CLIENT_ID_FILE=/run/secrets/agen-client-id
FRONTEGG_SECRET_FILE=/run/secrets/agen-secret
# FRONTEGG_CLIENT_ID=
# FRONTEGG_SECRET=

# ── Sync behaviour ───────────────────────────────────────────────────────────
# Only Google groups whose email starts with this prefix are synced, and only Frontegg
# groups with this prefix are ever written to. Minimum 2 characters.
SYNC_GROUP_PREFIX=agen-

# Blast-radius guards. A pass whose plan exceeds max(FRACTION, FLOOR) — capped at CAP —
# refuses to run and STAYS refused until you clear it. See docs/OPERATIONS.md §8.
SYNC_GUARD_FRACTION=0.2
SYNC_GUARD_FLOOR=3
SYNC_GUARD_CAP=500

# Hard ceiling on writes in one pass. A plan wanting more is worth reading first.
SYNC_MAX_WRITES_PER_PASS=2000

# Where the lock and the tripped-guard flag live. Must persist between passes.
SYNC_STATE_PATH=/var/lib/agen-group-sync/state.json
